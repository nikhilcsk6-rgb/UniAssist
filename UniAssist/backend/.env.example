FLASK_ENV=development
# Use random strings of 32+ characters (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate-a-random-32+-char-string
JWT_SECRET_KEY=generate-another-random-32+-char-string

# ---- Database ----
# Option 1 (easiest, no install, no password): SQLite. Creates the file backend/instance/uniassist.db automatically.
DATABASE_URL=sqlite:///uniassist.db
# Option 2 (MySQL): create the DB first (run database/schema.sql), then comment out the line above and use this one.
# If the password has special characters, URL-encode them (@ -> %40, # -> %23, : -> %3A).
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/uniassist

# ---- LLM provider: gemini (default, has a free tier) or openai ----
LLM_PROVIDER=gemini
# Gemini key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Model names change over time: check Google AI Studio for currently available names.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Embeddings follow LLM_PROVIDER. "fake" = offline word-overlap embeddings for testing only (never for real use).
# EMBEDDINGS_PROVIDER=gemini

# Only if LLM_PROVIDER=openai (also set RAG_MIN_SIMILARITY=0.3):
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHROMA_DIR=./chroma_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173

# RAG tuning (calibrate RAG_MIN_SIMILARITY with the Research module; it depends on the embedding model)
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5
LLM_TEMPERATURE=0.1
MAX_CONTEXT_CHARS=24000

# Optional: Unicode TTF so PDFs can print Kannada/Hindi (e.g. NotoSansKannada-Regular.ttf)
# PDF_FONT_PATH=C:\Windows\Fonts\Nirmala.ttf
